{
  "$defs": {
    "PageRegion": {
      "additionalProperties": false,
      "description": "PDF points, origin at the top-left; not image pixels.",
      "properties": {
        "page_width": {
          "exclusiveMinimum": 0,
          "title": "Page Width",
          "type": "number"
        },
        "page_height": {
          "exclusiveMinimum": 0,
          "title": "Page Height",
          "type": "number"
        },
        "x0": {
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "top": {
          "minimum": 0,
          "title": "Top",
          "type": "number"
        },
        "x1": {
          "exclusiveMinimum": 0,
          "title": "X1",
          "type": "number"
        },
        "bottom": {
          "exclusiveMinimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "scope": {
          "default": "page_context",
          "enum": [
            "page_context",
            "isolated"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "page_width",
        "page_height",
        "x0",
        "top",
        "x1",
        "bottom"
      ],
      "title": "PageRegion",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "properties": {
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "row_span": {
          "default": 1,
          "minimum": 1,
          "title": "Row Span",
          "type": "integer"
        },
        "column_span": {
          "default": 1,
          "minimum": 1,
          "title": "Column Span",
          "type": "integer"
        },
        "role": {
          "default": "data",
          "enum": [
            "header",
            "row_header",
            "data"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "state": {
          "default": "present",
          "enum": [
            "present",
            "blank",
            "unreadable"
          ],
          "title": "State",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "row",
        "column",
        "text"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "TableContent": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "minimum": 1,
          "title": "Rows",
          "type": "integer"
        },
        "columns": {
          "minimum": 1,
          "title": "Columns",
          "type": "integer"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TableCell"
          },
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "footnotes": {
          "items": {
            "type": "string"
          },
          "title": "Footnotes",
          "type": "array"
        }
      },
      "required": [
        "rows",
        "columns",
        "cells"
      ],
      "title": "TableContent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_id": {
      "pattern": "^[A-Za-z0-9:._-]+$",
      "title": "Artifact Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "figure",
        "table"
      ],
      "title": "Kind",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "investigation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Investigation Id"
    },
    "physical_page": {
      "minimum": 1,
      "title": "Physical Page",
      "type": "integer"
    },
    "printed_page": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Printed Page"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "caption": {
      "title": "Caption",
      "type": "string"
    },
    "region": {
      "$ref": "#/$defs/PageRegion"
    },
    "crop_path": {
      "title": "Crop Path",
      "type": "string"
    },
    "crop_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Crop Sha256",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "visible_labels": {
      "items": {
        "type": "string"
      },
      "title": "Visible Labels",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "method": {
      "default": "caption_only",
      "enum": [
        "caption_only",
        "openai_vision",
        "manual",
        "table_parser"
      ],
      "title": "Method",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "review_status": {
      "default": "unreviewed",
      "enum": [
        "unreviewed",
        "reviewed",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "table": {
      "anyOf": [
        {
          "$ref": "#/$defs/TableContent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    }
  },
  "required": [
    "artifact_id",
    "kind",
    "source_id",
    "source_sha256",
    "filename",
    "physical_page",
    "label",
    "caption",
    "region",
    "crop_path",
    "crop_sha256"
  ],
  "title": "VisualArtifact",
  "type": "object"
}
